{
  "name": "standappodoro",
  "productName": "StandAppodoro",
  "version": "1.0.0",
  "description": "Every 30 minutes the laptop becomes unusable until you stand app.",
  "main": "main.js",
  "author": "Sirio",
  "license": "MIT",
  "repository": "github:SirSirio/StandAppodoro",
  "scripts": {
    "start": "electron .",
    "fast": "electron . --fast",
    "break": "electron . --break-now",
    "icons": "node tools/gen-icon.js 32 assets/icon.png && node tools/gen-icon.js 256 build/icon.png",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.sirio.standappodoro",
    "productName": "StandAppodoro",
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "warning.html",
      "tray.html",
      "assets/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "StandAppodoro-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github"
    }
  }
}
